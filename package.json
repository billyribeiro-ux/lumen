{
  "name": "lumen",
  "version": "1.4.0",
  "private": true,
  "description": "Keyboard-driven knowledge OS for builders — your second brain, lit.",
  "homepage": "https://lumen.so",
  "repository": {
    "type": "git",
    "url": "https://github.com/billyribeiro-ux/lumen.git"
  },
  "license": "MIT",
  "author": "Billy Ribeiro <welberribeirodrums@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write '**/*.svelte'",
    "format:check": "biome format . && prettier --check '**/*.svelte'",
    "ci:lint": "biome ci . && prettier --check '**/*.svelte'",
    "test:unit": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test": "pnpm test:unit --run && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:wipe": "tsx scripts/seed/wipe.ts",
    "db:reset": "tsx scripts/seed/reset.ts",
    "stripe:sync": "tsx scripts/stripe/sync.ts",
    "stripe:seed-customers": "tsx scripts/stripe/seed-customers.ts",
    "stripe:listen": "stripe listen --forward-to localhost:5173/api/webhooks/stripe",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon static/favicon.svg"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@playwright/test": "^1.60.0",
    "@sentry/sveltekit": "^10.56.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitest/browser-playwright": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.9",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@better-auth/passkey": "^1.6.14",
    "@iconify/svelte": "^5.2.1",
    "@motion-core/motion-gpu": "^0.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tauri-apps/api": "^2.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.14",
    "bits-ui": "^2.18.1",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "resend": "^6.12.4",
    "shiki": "^4.2.0",
    "stripe": "^22.2.0",
    "sveltekit-superforms": "^2.30.1",
    "valibot": "^1.4.1",
    "ws": "^8.21.0"
  }
}
